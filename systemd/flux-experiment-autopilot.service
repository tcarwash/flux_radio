[Unit]
Description=Flux trusted experiment queue (read-only GitHub intake + pinned runners)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/storage5/dev/flux-batch-api-config
ExecStart=/usr/bin/python3 /storage5/dev/flux-batch-api-config/tools/k6_experiment_intake.py --once
ExecStart=/usr/bin/python3 /storage5/dev/flux-batch-api-config/tools/k6_experiment_autopilot.py --once --publish
ExecStart=/usr/bin/python3 /storage5/dev/flux-batch-api-config/tools/k6_experiment_review.py --once
ExecStart=/usr/bin/python3 /storage5/dev/flux-batch-api-config/tools/k6_experiment_postmortem.py --once
ExecStart=/usr/bin/python3 /storage5/dev/flux-batch-api-config/tools/k6_experiment_hardware_autopilot.py --once
TimeoutStartSec=650
NoNewPrivileges=yes
UMask=0077
