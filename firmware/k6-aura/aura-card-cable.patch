+    0
+}
+#[cfg(feature = "spilib")]
+unsafe extern "C" fn card_flash_erase(addr: u32) -> i32 {
+    if !CARD_WRITES_ALLOWED || CARD_NOR.is_null() || addr < CARD_BASE || addr >= CARD_END ||
+        addr % 4096 != 0 || addr + 4096 > CARD_END {
+        return -1;
+    }
+    (*CARD_NOR).erase_sector(addr);
+    0
