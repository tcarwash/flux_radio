+    if !CARD_WRITES_ALLOWED || src.is_null() || CARD_NOR.is_null() || n == 0 || n > CARD_PAGE ||
+        addr < CARD_BASE || addr >= CARD_END || n > CARD_END - addr || (addr % CARD_PAGE) + n > CARD_PAGE {
+        return -1;
+    }
