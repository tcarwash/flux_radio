+#[cfg(feature = "spilib")]
+unsafe extern "C" fn card_flash_read(addr: u32, dst: *mut u8, n: u32) -> i32 {
+    if dst.is_null() || CARD_NOR.is_null() || addr < CARD_BASE || addr >= CARD_END || n > CARD_END - addr {
+        return -1;
+    }
+    if !(*CARD_NOR).read_bytes_checked(addr, core::slice::from_raw_parts_mut(dst, n as usize)) {
+        return -1;
+    }
